# ── WordPress Headless CMS API (adil-portfolio-headless plugin) ──────────────
NEXT_PUBLIC_WP_API=https://api.adilashrafi.com/wp-json/adil/v1

# ── ISR Revalidation Token ───────────────────────────────────────────────────
