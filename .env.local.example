# ── WordPress Headless CMS API (headless-portfolio-cms plugin) ──────────────
NEXT_PUBLIC_WP_API=https://yourwordpresssite.com/wp-json/hpcms/v1

# ── WordPress Core REST API (used for the /blog section — wp/v2 posts) ───────
# Same WordPress site, no plugin required. Optional — defaults to the core API
# on the same host as NEXT_PUBLIC_WP_API.
NEXT_PUBLIC_WP_CORE_API=https://https://yourwordpresssite.com/wp-json/wp/v2

# ── ISR Revalidation Token ───────────────────────────────────────────────────
# Copy this from: WordPress Admin → Portfolio CMS → Settings → Revalidation Token
REVALIDATE_TOKEN=your-token-from-plugin-settings
